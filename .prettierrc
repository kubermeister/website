{
    "printWidth": 120,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": ["*.json", "*.yml", "*.yaml", "*.md", "*.mdx"],
            "options": { "tabWidth": 2 }
        },
        {
            "files": "*.astro",
            "options": { "parser": "astro" }
        }
    ]
}
