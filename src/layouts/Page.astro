---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Node = Record<string, unknown>;

interface Props {
    title: string;
    description: string;
    path: string;
    schema?: readonly Node[];
    noindex?: boolean;
    bareTitle?: boolean;
}

const { title, description, path, schema, noindex, bareTitle } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead
            title={title}
            description={description}
            path={path}
            schema={schema}
            noindex={noindex}
            bareTitle={bareTitle}
        />
    </head>
    <body class="min-h-screen antialiased">
        <a
            href="#content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
        >
            Skip to content
        </a>
        <Header />
        <main id="content">
            <slot />
        </main>
        <Footer />
    </body>
</html>
