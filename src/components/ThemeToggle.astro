---
// Writes Starlight's own storage key so the choice carries between the marketing pages and /docs/.
---

<button
    type="button"
    class="grid size-9 place-items-center rounded-lg border border-line text-muted transition-colors hover:border-line-hi hover:text-fg"
    data-theme-toggle
    aria-label="Switch between light and dark"
>
    <svg
        class="size-4 dark:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
    >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg
        class="hidden size-4 dark:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
    >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
</button>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        button.addEventListener('click', () => {
            const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            document.documentElement.dataset.theme = next;
            try {
                localStorage.setItem('starlight-theme', next);
            } catch {
                // A private window refuses to store; the toggle still works for this page view.
            }
        });
    }
</script>
