---
interface Props {
    id?: string;
    eyebrow?: string;
    title: string;
    lead?: string;
    /** Centres the heading block; left-aligned reads better when the content below is prose. */
    center?: boolean;
    class?: string;
}

const { id, eyebrow, title, lead, center = false, class: className } = Astro.props;
---

<section id={id} class:list={['py-20 sm:py-28', className]}>
    <div class="container-page">
        <div class:list={['max-w-3xl', center && 'mx-auto text-center']}>
            {eyebrow && <p class="text-xs font-semibold tracking-widest text-accent uppercase">{eyebrow}</p>}
            <h2 class="mt-3 text-h2 font-semibold text-balance text-fg">{title}</h2>
            {lead && <p class="mt-4 text-lead text-pretty text-muted">{lead}</p>}
        </div>
        <slot />
    </div>
</section>
