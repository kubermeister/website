---
import type { IconName } from '../lib/features';

interface Props {
    name: IconName;
    class?: string;
}

const { name, class: className } = Astro.props;

// Single-path line icons, drawn on a 24-unit grid at 1.6 stroke so they sit at the weight of the
// body text rather than shouting over it.
const PATHS: Record<IconName, string> = {
    activity: 'M3 12h4l3-8 4 16 3-8h4',
    terminal: 'M4 4h16v16H4zM8 9l3 3-3 3M13 15h4',
    scroll: 'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5',
    plug: 'M9 3v6M15 3v6M6 9h12v3a6 6 0 0 1-12 0zM12 18v3',
    helm: 'M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4M12 12h.01',
    node: 'M3 7h18v10H3zM7 11h.01M11 11h.01M7 14h6',
    shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4',
    chart: 'M4 20V4M4 20h16M8 16v-5M12 16V8M16 16v-3M20 16v-8',
    diff: 'M7 4v10M7 4 4 7M7 4l3 3M17 20V10M17 20l3-3M17 20l-3-3',
    search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.5-4.5',
    file: 'M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4M9 13h6M9 17h4',
    bell: 'M12 3a6 6 0 0 0-6 6c0 5-2 6-2 6h16s-2-1-2-6a6 6 0 0 0-6-6zM10 20a2 2 0 0 0 4 0',
};
---

<svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    <path d={PATHS[name]}></path>
</svg>
