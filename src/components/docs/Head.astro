---
import Default from '@astrojs/starlight/components/Head.astro';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { SITE, absolute } from '../../lib/site';
import { graph, organization, website, softwareApplication, breadcrumbs } from '../../lib/schema';
import { latestRelease } from '../../lib/release';

// Starlight emits the title, description, canonical and the og:/twitter: text tags itself. What it
// does not emit is a social image, structured data or the icons, so only those are added here —
// adding a tag Starlight already writes would leave the page with two of it.
const { entry, id } = Astro.locals.starlightRoute;
const release = await latestRelease();

const path = `/${id}/`;
const canonical = absolute(path);
const socialImage = absolute(`/og/${id}.png`);
const title = entry.data.title;
const description = entry.data.description ?? SITE.description;

const trail = [
    { name: 'Home', path: '/' },
    { name: 'Documentation', path: '/docs/' },
];
if (id !== 'docs') trail.push({ name: title, path });

const article = {
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    headline: title,
    description,
    url: canonical,
    inLanguage: 'en',
    isPartOf: { '@id': absolute('/#website') },
    about: { '@id': absolute('/#software') },
    author: { '@id': absolute('/#organization') },
    publisher: { '@id': absolute('/#organization') },
    ...(entry.data.lastUpdated instanceof Date ? { dateModified: entry.data.lastUpdated.toISOString() } : {}),
};
---

<Default>
    <slot />
</Default>

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:image" content={socialImage} />
{SITE.social && <meta name="twitter:site" content={SITE.social} />}

<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />

<script
    type="application/ld+json"
    is:inline
    set:html={graph([
        organization(),
        website(),
        softwareApplication(release.version, release.publishedAt),
        article,
        breadcrumbs(trail),
    ])}
></script>
