---
import { Icon } from '@astrojs/starlight/components';
import { EXTERNAL } from '../../lib/links';
import { SOCIAL } from '../../lib/site';

// Starlight's SocialIcons with the new-tab attributes added; `me` is kept from the original, since
// it is what tells a profile that links back here that the two belong together.
---

{SOCIAL.map(({ label, href, icon }) => (
    <a {href} target={EXTERNAL.target} rel={`me ${EXTERNAL.rel}`} class="sl-flex">
        <span class="sr-only">{label}</span>
        <Icon name={icon} />
    </a>
))}

<style>
    @layer starlight.core {
        a {
            color: var(--sl-color-text-accent);
            padding: 0.5em;
            margin: -0.5em;
        }
        a:hover {
            color: var(--sl-color-white);
        }
    }
</style>
