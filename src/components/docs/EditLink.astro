---
import { Icon } from '@astrojs/starlight/components';
import { EXTERNAL } from '../../lib/links';

// Starlight's EditLink with the new-tab attributes added. The edit URL always points at the app
// repository on GitHub (see scripts/fetch-docs.mjs), so it is always external.
const { editUrl } = Astro.locals.starlightRoute;
---

{editUrl && (
    <a href={editUrl} {...EXTERNAL} class="sl-flex print:hidden">
        <Icon name="pencil" size="1.2em" />
        {Astro.locals.t('page.editLink')}
    </a>
)}

<style>
    @layer starlight.core {
        a {
            gap: 0.5rem;
            align-items: center;
            text-decoration: none;
            color: var(--sl-color-gray-3);
        }
        a:hover {
            color: var(--sl-color-white);
        }
    }
</style>
