---
import Shot from '../Shot.astro';

interface Props {
    /** A shot name from the app's screenshot harness — see scripts/sync-screenshots.mjs. */
    name: string;
    alt: string;
    /** Shown under the image. Says what to look at, rather than repeating the alt text. */
    caption?: string;
}

const { name, alt, caption } = Astro.props;
---

<figure class="km-figure">
    <Shot
        name={name}
        alt={alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 72rem) 50rem, calc(100vw - 3rem)"
        class="km-figure-image"
    />
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .km-figure {
        margin: 1.75rem 0;
    }

    .km-figure :global(.km-figure-image) {
        width: 100%;
        height: auto;
        border: 1px solid var(--sl-color-hairline);
        border-radius: 10px;
    }

    figcaption {
        margin-top: 0.625rem;
        font-size: var(--sl-text-sm);
        line-height: 1.5;
        color: var(--sl-color-gray-3);
    }
</style>
