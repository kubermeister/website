---
import { VIDEOS } from '../lib/videos';

/**
 * The hero plays the silent montage muted, on loop, to someone who has not decided to watch yet. A
 * play button over it, shown on hover where there is a pointer and always where there is not, opens
 * the narrated overview in a dialog, since it has sound. Both are dark recordings whatever the
 * page's theme: the app is filmed once.
 */
---

<div class="group relative overflow-hidden rounded-2xl border border-line bg-surface shadow-card">
    <video
        class="aspect-video w-full"
        poster={VIDEOS.poster}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Kubermeister in use: the cluster summary, the command palette, logs, a shell, a rollout diff, a manifest review, a Helm release, a drain plan, a port forward, a secret and a custom resource."
        data-hero-video
    >
        <source src={VIDEOS.hero} type="video/mp4" />
    </video>
    <button
        type="button"
        class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors hover:bg-black/20 focus-visible:bg-black/20 focus-visible:outline-none"
        aria-label={`Watch the overview, ${VIDEOS.overviewDuration}`}
        data-overview-open
    >
        <span class="flex items-center gap-3 rounded-full bg-black/65 py-3 pr-6 pl-5 text-base font-medium text-white shadow-card backdrop-blur transition-opacity [@media(hover:hover)]:opacity-0 [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:group-focus-within:opacity-100">
            <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5.5v13l10-6.5z"></path>
            </svg>
            Watch the overview
            <span class="text-white/70">{VIDEOS.overviewDuration}</span>
        </span>
    </button>
</div>

<dialog
    class="m-auto w-[min(96vw,160vh)] max-w-none rounded-2xl border border-line bg-black p-0 shadow-card backdrop:bg-black/80"
    aria-label="Kubermeister overview video"
    data-overview-dialog
>
    <video class="aspect-video w-full rounded-2xl" poster={VIDEOS.poster} controls playsinline preload="none">
        <source src={VIDEOS.overview} type="video/mp4" />
    </video>
    <button
        type="button"
        class="absolute top-3 right-3 rounded-full bg-black/60 p-2 text-white transition-colors hover:bg-black/80"
        aria-label="Close"
        data-overview-close
    >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
    </button>
</dialog>

<script>
    const hero = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    // A visitor who asked for less motion gets the poster frame; the play button still opens the overview.
    if (hero && matchMedia('(prefers-reduced-motion: reduce)').matches) {
        hero.removeAttribute('autoplay');
        hero.pause();
    }

    const dialog = document.querySelector<HTMLDialogElement>('[data-overview-dialog]');
    const overview = dialog?.querySelector('video');
    const open = document.querySelector<HTMLButtonElement>('[data-overview-open]');
    const close = dialog?.querySelector<HTMLButtonElement>('[data-overview-close]');
    if (dialog && overview && open && close) {
        open.addEventListener('click', () => {
            dialog.showModal();
            void overview.play();
        });
        close.addEventListener('click', () => dialog.close());
        // A click on the backdrop lands on the dialog element itself, not on anything inside it.
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener('close', () => overview.pause());
    }
</script>
