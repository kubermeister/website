---
import { FOOTER, SITE } from '../lib/site';
import { EXTERNAL, isExternal } from '../lib/links';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface/40">
    <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-1">
            <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-fg">
                <Logo class="size-6 text-accent" />
                <span>Kubermeister</span>
            </a>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{SITE.tagline}. Free and open source.</p>
        </div>

        {FOOTER.map((column) => (
            <div>
                <h2 class="text-xs font-semibold tracking-widest text-dim uppercase">{column.title}</h2>
                <ul class="mt-4 space-y-2.5">
                    {column.links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                {...(isExternal(link.href) ? EXTERNAL : {})}
                                class="text-sm text-muted transition-colors hover:text-fg"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>

    <div class="border-t border-line">
        <div class="container-page flex flex-wrap items-center justify-between gap-4 py-6 text-sm text-dim">
            <p>
                © {year} {SITE.copyrightHolder} · Released under the{' '}
                <a
                    href={SITE.license.href}
                    {...EXTERNAL}
                    class="underline underline-offset-2 transition-colors hover:text-fg"
                >
                    {SITE.license.name}
                </a>
            </p>
            <p>
                Kubernetes and Helm are trademarks of The Linux Foundation. Kubermeister is an independent project, not
                affiliated with or endorsed by The Linux Foundation or the CNCF. Other names are trademarks of their
                respective owners.
            </p>
        </div>
    </div>
</footer>
