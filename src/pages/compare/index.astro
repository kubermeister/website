---
import Page from '../../layouts/Page.astro';
import { COMPETITORS } from '../../lib/compare';
import { page } from '../../lib/pages';
import { breadcrumbs } from '../../lib/schema';

const meta = page('/compare/');
---

<Page
    title={meta.title}
    description={meta.description}
    path={meta.path}
    schema={[
        breadcrumbs([
            { name: 'Home', path: '/' },
            { name: 'Compare', path: '/compare/' },
        ]),
    ]}
>
    <div class="border-b border-line">
        <div class="container-page py-16 text-center sm:py-20">
            <h1 class="mx-auto max-w-3xl text-h1 font-semibold text-balance">How Kubermeister compares</h1>
            <p class="mx-auto mt-5 max-w-2xl text-lead text-pretty text-muted">
                Four comparisons, each written to be useful rather than flattering — including the cases where the other
                tool is the one you should use.
            </p>
        </div>
    </div>

    <div class="container-page py-14">
        <ul class="grid gap-5 md:grid-cols-2">
            {COMPETITORS.map((entry) => (
                <li>
                    <a
                        href={`/compare/${entry.slug}/`}
                        class="group block h-full rounded-2xl border border-line p-7 transition-colors hover:border-accent"
                    >
                        <p class="text-xs font-semibold tracking-widest text-dim uppercase">Compare</p>
                        <h2 class="mt-2 text-h2 font-semibold text-fg group-hover:text-accent">vs {entry.name}</h2>
                        <p class="mt-1 text-sm text-muted">{entry.kind}</p>
                        <p class="mt-4 text-sm leading-relaxed text-fg-2">{entry.description}</p>
                        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                            Read the comparison <span aria-hidden="true">→</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>

        <div class="mt-14 rounded-2xl border border-line bg-surface/40 p-8">
            <h2 class="text-h3 font-semibold">A note on how these are written</h2>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
                Claims about Kubermeister come from how the app actually behaves. Claims about another tool are kept to
                characteristics that are stable and easy to check for yourself — nobody's release notes are being
                paraphrased here, and nothing version- or price-specific is asserted, because that goes stale and a
                comparison that gets a rival's facts wrong is worth less than no comparison at all. If you maintain one
                of these tools and something here is wrong,
                <a
                    href="https://github.com/kubermeister/website/issues"
                    rel="noopener"
                    class="text-accent hover:underline"
                >
                    please open an issue
                </a>
                and it will be fixed.
            </p>
        </div>
    </div>
</Page>
