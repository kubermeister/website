---
import type { GetStaticPaths } from 'astro';
import Page from '../../layouts/Page.astro';
import DownloadCta from '../../components/DownloadCta.astro';
import { COMPETITORS } from '../../lib/compare';
import { page } from '../../lib/pages';
import { breadcrumbs, faqPage } from '../../lib/schema';

export const getStaticPaths = (() =>
    COMPETITORS.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const meta = page(`/compare/${entry.slug}/`);
---

<Page
    title={meta.title}
    description={meta.description}
    path={meta.path}
    schema={[
        breadcrumbs([
            { name: 'Home', path: '/' },
            { name: 'Compare', path: '/compare/' },
            { name: `vs ${entry.name}`, path: meta.path },
        ]),
        faqPage(entry.faqs),
    ]}
>
    <div class="border-b border-line">
        <div class="container-page py-16 sm:py-20">
            <nav aria-label="Breadcrumb" class="text-sm text-dim">
                <a href="/" class="hover:text-fg">
                    Home
                </a>
                <span aria-hidden="true" class="mx-2">
                    /
                </span>
                <a href="/compare/" class="hover:text-fg">
                    Compare
                </a>
            </nav>
            <h1 class="mt-4 max-w-3xl text-h1 font-semibold text-balance">{entry.title}</h1>
            <p class="mt-5 max-w-3xl text-lead text-pretty text-muted">{entry.description}</p>
        </div>
    </div>

    <section class="container-page py-14">
        <div class="max-w-3xl">
            <h2 class="text-h2 font-semibold">About {entry.name}</h2>
            <p class="mt-4 leading-relaxed text-pretty text-fg-2">{entry.about}</p>
        </div>
    </section>

    <section class="container-page pb-14">
        <h2 class="text-h2 font-semibold">Side by side</h2>
        <div class="mt-8 overflow-x-auto">
            <table class="w-full min-w-[52rem] border-collapse text-sm">
                <caption class="sr-only">Kubermeister compared with{entry.name}, feature by feature</caption>
                <thead>
                    <tr class="border-b border-line-hi text-left">
                        <th scope="col" class="w-44 py-3 pr-4 font-semibold text-dim">
                            Feature
                        </th>
                        <th scope="col" class="w-1/2 py-3 pr-6 font-semibold text-accent">
                            Kubermeister
                        </th>
                        <th scope="col" class="py-3 font-semibold text-fg">
                            {entry.name}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {entry.rows.map((row) => (
                        <tr class="border-b border-line align-top">
                            <th scope="row" class="py-4 pr-4 text-left font-medium text-fg">
                                {row.feature}
                            </th>
                            <td class="py-4 pr-6 leading-relaxed text-fg-2">{row.cell.km}</td>
                            <td class="py-4 leading-relaxed text-muted">{row.cell.them}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>

    <section class="border-y border-line bg-surface/30">
        <div class="container-page grid gap-10 py-14 md:grid-cols-2 md:gap-14">
            <div>
                <h2 class="text-h3 font-semibold">Choose {entry.name} if…</h2>
                <ul class="mt-5 space-y-3">
                    {entry.pickThem.map((point) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-fg-2">
                            <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-muted" />
                            <span>{point}</span>
                        </li>
                    ))}
                </ul>
            </div>
            <div>
                <h2 class="text-h3 font-semibold">Choose Kubermeister if…</h2>
                <ul class="mt-5 space-y-3">
                    {entry.pickKm.map((point) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-fg-2">
                            <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" />
                            <span>{point}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <section class="container-page py-14">
        <h2 class="text-h2 font-semibold">Questions</h2>
        <div class="mt-8 max-w-3xl divide-y divide-line border-y border-line">
            {entry.faqs.map((faq) => (
                <details class="group py-5">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-fg">
                        <h3>{faq.question}</h3>
                        <svg
                            class="size-5 shrink-0 text-dim transition-transform group-open:rotate-45"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            aria-hidden="true"
                        >
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </summary>
                    <p class="mt-3 pr-9 text-sm leading-relaxed text-muted">{faq.answer}</p>
                </details>
            ))}
        </div>
    </section>

    <section class="border-t border-line">
        <div class="container-page py-20 text-center">
            <h2 class="text-h2 font-semibold text-balance">Try it against a cluster you already have</h2>
            <p class="mx-auto mt-4 max-w-xl text-lead text-muted">
                It reads your kubeconfig and changes nothing about it, so nothing has to be decided up front.
            </p>
            <div class="mt-9 flex flex-col items-center">
                <DownloadCta />
            </div>
            <p class="mt-8 text-sm text-dim">
                Other comparisons:
                {COMPETITORS.filter((other) => other.slug !== entry.slug).map((other, index) => (
                    <>
                        {index > 0 && <span aria-hidden="true"> · </span>}
                        <a href={`/compare/${other.slug}/`} class="text-accent hover:underline">
                            vs {other.name}
                        </a>
                    </>
                ))}
            </p>
        </div>
    </section>
</Page>
