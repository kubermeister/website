---
import Page from '../layouts/Page.astro';
import CopyLine from '../components/CopyLine.astro';
import { PLATFORMS, downloadUrl, SITE } from '../lib/site';
import { latestRelease } from '../lib/release';
import { page } from '../lib/pages';
import { howTo, breadcrumbs } from '../lib/schema';

const meta = page('/download/');
const release = await latestRelease();

// A release whose asset list came back from the API hides a download it does not actually have; the
// committed fallback carries no list, in which case every platform is offered as before.
const published = (asset: string) => release.assets.length === 0 || release.assets.includes(asset);

const groups = [
    { os: 'macos' as const, label: 'macOS', hint: 'Developer ID signed and notarized. macOS 11 or newer.' },
    { os: 'windows' as const, label: 'Windows', hint: 'Windows 10 or newer, x86-64.' },
    {
        os: 'linux' as const,
        label: 'Linux',
        hint: 'x86-64. The AppImage installs nothing; the .deb is for Debian and Ubuntu.',
    },
];

const published_at = new Date(release.publishedAt).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
});
---

<Page
    title={meta.title}
    description={meta.description}
    path={meta.path}
    schema={[
        breadcrumbs([
            { name: 'Home', path: '/' },
            { name: 'Download', path: '/download/' },
        ]),
        howTo({
            name: 'Install Kubermeister',
            description: 'Install the Kubermeister desktop Kubernetes client on macOS, Windows or Linux.',
            steps: [
                {
                    name: 'Choose your platform',
                    text: 'Pick the installer for your operating system and architecture.',
                },
                {
                    name: 'Run the installer',
                    text: 'Open the .dmg and drag the app to Applications on macOS, run the .exe on Windows, or make the AppImage executable on Linux.',
                },
                {
                    name: 'Open the app',
                    text: 'Kubermeister reads the kubeconfig you already have. No account or sign-in is required.',
                },
            ],
        }),
    ]}
>
    <div class="border-b border-line">
        <div class="container-page py-16 text-center sm:py-20">
            <h1 class="text-h1 font-semibold text-balance">Download Kubermeister</h1>
            <p class="mx-auto mt-5 max-w-2xl text-lead text-pretty text-muted">
                Version {release.version}, released {published_at}. Free and open source — no account, no licence key,
                no seat count.
            </p>
            <p class="mt-4 text-sm text-dim">
                <a href={release.htmlUrl} rel="noopener" class="text-accent hover:underline">
                    Release notes on GitHub
                </a>
                ·{' '}
                <a href="/changelog/" class="text-accent hover:underline">
                    What changed
                </a>
            </p>
        </div>
    </div>

    <section class="container-page py-14">
        <h2 class="text-h2 font-semibold">Homebrew</h2>
        <p class="mt-3 max-w-2xl text-muted">
            The least friction on macOS, and it keeps the app updated with everything else you install that way.
        </p>
        <div class="mt-5 max-w-2xl space-y-3">
            <CopyLine command="brew install --cask kubermeister/tap/kubermeister" />
            <CopyLine command="brew upgrade --cask kubermeister" label="Copy upgrade command" />
        </div>
    </section>

    <section class="container-page pb-16">
        <h2 class="text-h2 font-semibold">Installers</h2>
        <div class="mt-8 space-y-8">
            {groups.map((group) => {
                const platforms = PLATFORMS.filter(
                    (p) => p.os === group.os && published(p.asset.replace('{v}', release.version)),
                );
                if (platforms.length === 0) return null;
                return (
                    <div class="rounded-2xl border border-line">
                        <div class="border-b border-line px-6 py-4">
                            <h3 class="text-h3 font-semibold">{group.label}</h3>
                            <p class="mt-1 text-sm text-muted">{group.hint}</p>
                        </div>
                        <ul class="divide-y divide-line">
                            {platforms.map((platform) => (
                                <li class="flex flex-wrap items-center gap-4 px-6 py-4">
                                    <div class="min-w-0 flex-1">
                                        <p class="font-medium text-fg">{platform.label}</p>
                                        <p class="mt-0.5 font-mono text-xs break-all text-dim">
                                            {platform.asset.replace('{v}', release.version)}
                                        </p>
                                    </div>
                                    <a
                                        href={downloadUrl(platform, release.version)}
                                        class="shrink-0 rounded-lg border border-line px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
                                    >
                                        Download
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                );
            })}
        </div>

        <p class="mt-8 text-sm text-muted">
            Looking for an older version, a checksum or the update feed? Everything is on the
            <a href={`${SITE.repo}/releases`} rel="noopener" class="text-accent hover:underline">
                releases page
            </a>
            .
        </p>
    </section>

    <section class="border-t border-line">
        <div class="container-page grid gap-10 py-16 md:grid-cols-3">
            <div>
                <h2 class="text-h3 font-semibold">After you install</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                    Kubermeister reads the kubeconfig you already have and changes nothing about it. If
                    <code class="font-mono text-xs">kubectl get pods</code> works, the app works.
                </p>
                <a href="/docs/start/first-cluster/" class="mt-3 inline-block text-sm text-accent hover:underline">
                    Your first five minutes →
                </a>
            </div>
            <div>
                <h2 class="text-h3 font-semibold">It updates itself</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                    By default a new version downloads in the background and installs when you quit. You can set it to
                    check only, or turn it off.
                </p>
                <a href="/docs/reference/updates/" class="mt-3 inline-block text-sm text-accent hover:underline">
                    How updates work →
                </a>
            </div>
            <div>
                <h2 class="text-h3 font-semibold">Nothing leaves your machine</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                    No backend, no account, no telemetry. The app talks to your API server and to GitHub for update
                    checks, and that is the whole list.
                </p>
                <a href="/docs/reference/security/" class="mt-3 inline-block text-sm text-accent hover:underline">
                    Security →
                </a>
            </div>
        </div>
    </section>
</Page>
